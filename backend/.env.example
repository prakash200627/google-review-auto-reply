# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- Required ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# --- Server ---
PORT=5000
# Set to "production" on Render. Required for the CORS allowlist; running on Render alone does not enable it.
NODE_ENV=development
# Extra comma-separated origins allowed by CORS in production (e.g. Vercel preview URLs).
CORS_ORIGINS=
# Frontend origin used for OAuth callback redirects (no trailing slash).
FRONTEND_URL=http://localhost:5173

# --- OpenAI (server-side only) ---
# Fallback key used when an organization has not saved its own key.
OPENAI_API_KEY=sk-your-openai-key
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# --- Google Business Profile OAuth ---
# Create an OAuth 2.0 Web client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI on the OAuth client.
# Example local: http://localhost:5000/api/google/oauth/callback
# Example production: https://<your-render-host>/api/google/oauth/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/oauth/callback
# 32-byte key for AES-256-GCM token encryption (64 hex chars OR base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never fall back to plaintext storage — publishing/sync fail closed without this.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Review sync & publish recovery ---
# How often the backend polls Google for new reviews (1-60, default 5).
REVIEW_SYNC_INTERVAL_MINUTES=5
# Minutes before an unconfirmed in-flight publish attempt can be reconciled (1-1440, default 15).
PUBLISH_STALE_AFTER_MINUTES=15
# Set true to disable the in-process sync scheduler (tests / maintenance).
DISABLE_REVIEW_SYNC=false

# --- Networking ---
# Optional comma-separated DNS servers for MongoDB SRV lookups (e.g. 8.8.8.8,1.1.1.1).
# Leave empty to use the system resolver. Set only if you see "querySrv ECONNREFUSED".
DNS_SERVERS=
